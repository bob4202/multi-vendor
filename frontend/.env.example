# Copy to frontend/.env and fill in. Only the Next.js server reads these;
# none of them reach the browser.

# The Go API (backend HTTP_ADDR). Called server-side only.
BASE_URL=http://localhost:8080/

# --- Storefront -------------------------------------------------------------
# Each storefront deployment is one branch. Get both values from the admin
# side (vendor > branch > "Storefront key"), or from `make seed` output
# locally (it prints each demo branch's id and key the first time).
BRANCH_ID=
STOREFRONT_KEY=

# --- Admin side (/admin) ----------------------------------------------------
# Off unless set to "enabled": every storefront deployment runs this same
# app, so turn it on only where admins sign in (and locally).
ADMIN_PORTAL=enabled

# Optional: base URL for the invite links admins send to vendors, e.g.
# https://vendors.example.com. Defaults to the host the admin is using.
# VENDOR_PORTAL_URL=
