# Copy to backend/.env and fill in. The Makefile loads it for `make dev`,
# `make migrate`, `make seed` and `make admin`.

# Postgres (matches docker-compose.yml for local development)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce_db?sslmode=disable
HTTP_ADDR=:8080

# Shared admin key for scripts and curl (header X-Admin-Key). People use
# their own admin logins instead; create one with `make admin`.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=change-me

# Encrypts branch inventory system API keys at rest. Must decode to 32 bytes.
# Generate with: openssl rand -base64 32
# Don't change it once branches exist - their stored keys become unreadable.
APP_ENCRYPTION_KEY=

# Inventory sync. The inventory system's API base URL, with {host} standing in
# for each branch's host (set per branch in the admin side). Sync is off while
# it's empty.
INVENTORY_API_URL=

# Inventory sync scheduler
SYNC_INTERVAL_MINUTES=15
SYNC_BRANCH_CONCURRENCY=3

# Minutes a shop has to accept a new order before it's cancelled automatically.
ORDER_ACCEPT_TIMEOUT_MINUTES=5

# Minutes a customer has to finish paying before the unpaid order is cancelled.
PAYMENT_WINDOW_MINUTES=30

# Optional, local dev only: password for every login `make seed` creates
# (vendor users and admin@groceryshop.example). Default: shop-demo-2026
# SEED_VENDOR_PASSWORD=

# --- Customer side (README §8) -------------------------------------------------

# Minutes a customer has to answer a proposed substitution before the item is
# removed instead.
SUBSTITUTION_TIMEOUT_MINUTES=10
# A ready collection order waits this long (or until closing, if sooner), then
# becomes a no-show after the grace period.
COLLECTION_WINDOW_MINUTES=60
COLLECTION_GRACE_MINUTES=6

# Customer emails (login codes, order updates). Locally: Mailpit from
# docker-compose, inbox at http://localhost:8025. Leave SMTP_HOST empty to only
# log emails instead of sending them.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="Grocery Shop <orders@groceryshop.example>"

# Web Push (VAPID). `make env` generates these; or: go run ./cmd/vapid
# Leave both empty to turn push notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:orders@groceryshop.example

# Payment providers this server can use, comma-separated (e.g. stripe).
# Each vendor connects an account with one of them. "fake" is a local test
# provider with a Pay / Fail page: never list it in production.
PAYMENT_PROVIDERS=fake
